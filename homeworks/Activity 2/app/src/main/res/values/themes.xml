<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StudentManagement" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialAlertDialogTheme">@style/Dialog.StudentManagement</item>
    </style>

    <style name="Dialog.StudentManagement" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Shape.StudentManagement.Dialog</item>
    </style>

    <style name="Shape.StudentManagement.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.StudentManagement.StatValue" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.StudentManagement.StatLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.StudentManagement.FormLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.StudentManagement.FieldError" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.StudentManagement.SectionTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
